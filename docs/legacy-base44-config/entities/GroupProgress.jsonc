{
  "name": "GroupProgress",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "Reference to the group"
    },
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "user_name": {
      "type": "string",
      "description": "User's display name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of progress"
    },
    "verses_read": {
      "type": "number",
      "description": "Verses read on this day"
    },
    "time_minutes": {
      "type": "number",
      "description": "Time spent reading"
    }
  },
  "required": [
    "group_id",
    "user_email",
    "date"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}