{
  "appId": "com.alquranapp.reader",
  "appName": "Al-Quran",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#121212",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#121212",
    "preferredContentMode": "mobile",
    "scrollEnabled": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#121212",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#121212",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark"
    }
  }
}
