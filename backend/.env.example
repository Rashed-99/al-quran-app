DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

PORT=4000
NODE_ENV=development
# Comma-separated. In production, include BOTH your web frontend's URL
# AND the Capacitor iOS app's origin (capacitor://localhost) - the native
# app is a distinct origin and won't be able to log in without it here.
# Example production value:
#   CORS_ORIGIN="https://your-app.vercel.app,capacitor://localhost"
CORS_ORIGIN="http://localhost:5173"

# JWT - generate real values before deploying, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; server refuses to boot in production
# with these placeholder values (see src/config/env.js).
JWT_ACCESS_SECRET="change-me-access-secret-change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret-change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
REFRESH_COOKIE_NAME="refresh_token"

# SMTP (weekly leaderboard emails, password reset) - optional at first;
# falls back to console logging until configured. Use Resend/SES free tier.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Al-Quran App <no-reply@example.com>"

# Companion (LLM) - free-tier provider, OpenAI-compatible chat completions endpoint
LLM_API_URL="https://api.your-llm-provider.com/v1/chat/completions"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
COMPANION_DAILY_MESSAGE_LIMIT="15"

# Tafsir precompute job only (not used by the running server / not
# validated by config/env.js since the seed script runs standalone)
TAFSIR_LLM_API_URL="https://api.your-llm-provider.com/v1/chat/completions"
TAFSIR_LLM_API_KEY=""
TAFSIR_LLM_MODEL="gpt-4o-mini"
